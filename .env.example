# GladRags environment variables.
# Copy to .env.local (gitignored) and fill in real values. Never commit real
# values. Set the same variables in Vercel for deployments.

# --- Local UI work without any accounts -------------------------------------
# "true": API routes serve in-memory mock data, sign-in is skipped and AI
# providers are fakes. The app refuses to run with it on Vercel or in a
# production build (`pnpm start`), unless GLADRAGS_E2E=true marks an
# end-to-end test run.
GLADRAGS_MOCK_MODE=false
GLADRAGS_E2E=false

# --- Supabase (Project Settings -> API Keys) --------------------------------
# Uses Supabase's new API keys, not the legacy anon / service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe in the browser; row-level security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Secret key: SERVER ONLY, bypasses row-level security. Only imported from
# server modules (src/lib/env.server.ts); never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Public base URL, used in sign-in emails. Leave empty locally to use the
# request's own address. On Vercel set it to the deployment URL.
NEXT_PUBLIC_SITE_URL=

# --- Gemini (tagging and outfit ranking) -------------------------------------
# Read by the ingestion and outfit-engine agents' providers (milestone 3).
# Free tier is fine for development; switch to paid before testers join.
GEMINI_API_KEY=replace-me
# Optional. The Gemini model for tagging and outfit ranking; defaults to
# gemini-3.8-flash. Must be a model with known prices (see GEMINI_MODEL_PRICES).
GEMINI_MODEL=gemini-3.8-flash

# Background removal runs in the user's browser, so there is no key for it.
