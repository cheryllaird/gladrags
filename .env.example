# GladRags environment variables.
# Copy to .env.local (gitignored) and fill in real values. Never commit real
# values. Set the same variables in Vercel for deployments.

# --- Local UI work without any accounts -------------------------------------
# "true": API routes serve in-memory mock data, sign-in is skipped and AI
# providers are fakes. The app refuses to run with it on Vercel or in a
# production build (`pnpm start`), unless GLADRAGS_E2E=true marks an
# end-to-end test run.
GLADRAGS_MOCK_MODE=false
GLADRAGS_E2E=false

# --- Supabase (Project Settings -> API Keys) --------------------------------
# Uses Supabase's new API keys, not the legacy anon / service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe in the browser; row-level security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Secret key: SERVER ONLY, bypasses row-level security. Only imported from
# server modules (src/lib/env.server.ts); never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Public base URL, used in sign-in emails. Leave empty locally to use the
# request's own address. On Vercel set it to the deployment URL.
NEXT_PUBLIC_SITE_URL=

# --- Gemini (tagging and outfit ranking) -------------------------------------
# Read by the ingestion and outfit-engine agents' providers (milestone 3).
# Free tier is fine for development; switch to paid before testers join.
GEMINI_API_KEY=replace-me
# Optional. The Gemini model for tagging and outfit ranking; defaults to
# gemini-3.8-flash. Must be a model with known prices (see GEMINI_MODEL_PRICES).
GEMINI_MODEL=gemini-3.8-flash

# Background removal runs in the user's browser, so there is no key for it.

# --- Scheduled cleanup ---------------------------------------------------------
# Vercel Cron calls GET /api/cron/cleanup daily (vercel.json) and sends
# "Authorization: Bearer <CRON_SECRET>". Use a long random value, e.g.
# `openssl rand -hex 32`. Without it the cleanup route refuses to run.
CRON_SECRET=replace-me-with-a-long-random-value

# --- Sign-in rate limits -------------------------------------------------------
# SERVER ONLY. The key for the pseudonymous hashes of emails and IP addresses
# in sign_in_attempts (HMAC-SHA-256). At least 32 characters, e.g.
# `openssl rand -hex 32`. Outside mock mode and tests, sign-in refuses to run
# without it.
SIGN_IN_HASH_KEY=replace-me-with-at-least-32-random-characters

# --- Order email forwarding (milestone 5) ------------------------------------
# Each user's private forwarding address is <prefix><token>@<domain>.
# INBOUND_EMAIL_DOMAIN is the domain the inbound email service receives mail
# for. Leave it empty and the app shows no address ("email import isn't set
# up yet"); mock mode then uses inbound.gladrags.test.
INBOUND_EMAIL_DOMAIN=
# Optional, put before the token: for a service with one fixed mailbox and
# plus-addressing. Postmark's "<hash>@inbound.postmarkapp.com" needs
# INBOUND_EMAIL_DOMAIN=inbound.postmarkapp.com and INBOUND_EMAIL_PREFIX=<hash>+
INBOUND_EMAIL_PREFIX=
# Which inbound email service posts to POST /api/inbound/email. Only
# "postmark" has an adapter so far (src/lib/email/postmark.ts).
INBOUND_EMAIL_PROVIDER=postmark
# Optional: the receiving service's Authentication-Results authserv-id(s) to
# trust, comma-separated. Leave empty for Postmark (it adds Received-SPF
# instead). Never put an id here that senders could also write themselves.
INBOUND_EMAIL_AUTHSERV_ID=
# SERVER ONLY. What the webhook checks the service's signature or
# credentials against. At least 32 characters, e.g. `openssl rand -hex 32`
# (hex, because for Postmark it goes in the webhook URL as the password:
# https://postmark:<secret>@<site>/api/inbound/email).
# Without it the webhook refuses every request.
INBOUND_EMAIL_WEBHOOK_SECRET=replace-me-with-at-least-32-random-characters
